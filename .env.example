# Copy to .env to override defaults. Placeholders only: never commit real secrets.

# Open-weight model served by Ollama (pulled automatically by docker compose)
FOUNDRY_MODEL=qwen3.5:9b
# 1 = let reasoning models think before answering (slower). Default 0.
FOUNDRY_THINK=0
FOUNDRY_OLLAMA_URL=http://ollama:11434
# Faster on a Mac: run Ollama on the host (it can use the GPU) and point the app at it:
# FOUNDRY_OLLAMA_URL=http://host.docker.internal:11434

# Web search: the SearXNG container started by docker compose. No key or account needed.
FOUNDRY_SEARXNG_URL=http://searxng:8080
# Optional. Session key for the local SearXNG container (never exposed outside compose).
SEARXNG_SECRET=replace-with-a-long-random-string

# auto = local Ollama. offline = test-only mock provider (labelled MOCKED in the app).
FOUNDRY_LLM_PROVIDER=auto

# Where project data and the decision log are stored
FOUNDRY_DB_PATH=data/foundry.sqlite3
FOUNDRY_DECISION_LOG=decision_log.json

# Optional. Signing key for founder approvals. If unset, a key is generated in data/.
FOUNDRY_APPROVAL_SECRET=replace-with-a-long-random-string
